{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "devCommand": "pnpm website:dev",
  "buildCommand": "pnpm build && pnpm website:build",
  "outputDirectory": ".output/client",
  "functions": {
    "api/index.ts": {
      "includeFiles": ".output/**/*",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}
