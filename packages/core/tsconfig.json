{
  // "extends": "@vue/tsconfig/tsconfig.dom.json",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": true,
    "types": ["node"],

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "include": [
    "./types",
    "./src/**/*",
    "./src/**/*.vue",
    "./playground/**/*",
    "./playground/**/*.vue",
    ".app/**/*.d.ts"
  ]
}
