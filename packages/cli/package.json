{
  "name": "@runablejs/cli",
  "version": "1.0.0-alpha.3",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runablejs/runable.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/runablejs/runable#readme",
  "bugs": {
    "url": "https://github.com/runablejs/runable/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "runable": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "starters",
    "skills"
  ],
  "scripts": {
    "build": "tsx scripts/copy-skills.ts && tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build",
    "runable": "tsx src/index.ts",
    "app:build": "runable build",
    "app:prepare": "runable prepare"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "consola": "catalog:",
    "dayjs": "catalog:",
    "esbuild": "catalog:",
    "giget": "catalog:",
    "lodash": "catalog:",
    "magicast": "catalog:",
    "nypm": "catalog:",
    "pkg-types": "catalog:",
    "runable": "workspace:^",
    "std-env": "catalog:",
    "tinyclip": "catalog:",
    "tinyexec": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "citty": "catalog:",
    "pkg": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
