    "giget": "^3.2.0",
    "lodash": "^4.18.1",
    "magicast": "^0.5.4",
    "nypm": "^0.6.6",
    "pkg-types": "^2.3.1",
    "std-env": "^4.1.0",
    "tinyclip": "^0.1.14",
    "tinyexec": "^1.2.4",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "citty": "^0.2.2",
    "pkg": "^5.8.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
