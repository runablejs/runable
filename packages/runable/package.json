    },
    "./adapters/deno": {
      "types": "./dist/adapters/deno.d.ts",
      "import": "./dist/adapters/deno.js",
      "require": "./dist/adapters/deno.js"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js",
      "require": "./dist/adapters/express.js"
