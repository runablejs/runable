{
  // "extends": "@vue/tsconfig/tsconfig.dom.json",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "noUncheckedIndexedAccess": true,
    "experimentalDecorators": true,

    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "include": ["./types", "./src/**/*", "./src/**/*.vue"]
}
